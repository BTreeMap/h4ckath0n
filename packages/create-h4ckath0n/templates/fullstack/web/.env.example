# `development` or `production`
H4CKATH0N_ENV=development

# SQLAlchemy connection string
H4CKATH0N_DATABASE_URL=sqlite:///./h4ckath0n.db

# Auto-run packaged DB migrations to head on startup
H4CKATH0N_AUTO_UPGRADE=false

# WebAuthn relying party ID, required in production
H4CKATH0N_RP_ID=

# WebAuthn origin, required in production
H4CKATH0N_ORIGIN=

# WebAuthn challenge TTL in seconds
H4CKATH0N_WEBAUTHN_TTL_SECONDS=300

# WebAuthn user verification requirement
H4CKATH0N_USER_VERIFICATION=preferred

# WebAuthn attestation preference
H4CKATH0N_ATTESTATION=none

# Enable password routes when the extra is installed
H4CKATH0N_PASSWORD_AUTH_ENABLED=false

# Password reset token expiry in minutes
H4CKATH0N_PASSWORD_RESET_EXPIRE_MINUTES=30

# JSON list of emails that become admin on password signup
H4CKATH0N_BOOTSTRAP_ADMIN_EMAILS=[]

# First password signup becomes admin
H4CKATH0N_FIRST_USER_IS_ADMIN=false

# OpenAI API key for the LLM wrapper
H4CKATH0N_OPENAI_API_KEY=

# Redis connection string
H4CKATH0N_REDIS_URL=

# Run background jobs inline in development mode
H4CKATH0N_JOBS_INLINE_IN_DEV=true

# Default Redis queue for background jobs
H4CKATH0N_JOBS_DEFAULT_QUEUE=default

# Storage backend
H4CKATH0N_STORAGE_BACKEND=local

# Local directory for uploaded files
H4CKATH0N_STORAGE_DIR=./.h4ckath0n_storage

# Maximum upload size in bytes (50 MiB)
H4CKATH0N_MAX_UPLOAD_BYTES=52428800

# Application base URL for email links
H4CKATH0N_APP_BASE_URL=http://localhost:5173

# Email backend: `file` or `smtp`
H4CKATH0N_EMAIL_BACKEND=file

# Sender address for outgoing emails
H4CKATH0N_EMAIL_FROM=noreply@localhost

# File-backend email output directory
H4CKATH0N_EMAIL_OUTBOX_DIR=./.h4ckath0n_email_outbox

# SMTP server host
H4CKATH0N_SMTP_HOST=

# SMTP server port
H4CKATH0N_SMTP_PORT=587

# SMTP authentication username
H4CKATH0N_SMTP_USERNAME=

# SMTP authentication password
H4CKATH0N_SMTP_PASSWORD=

# Enable SMTP STARTTLS
H4CKATH0N_SMTP_STARTTLS=true

# Enable SMTP-over-SSL
H4CKATH0N_SMTP_SSL=false

# Enable demo mode
H4CKATH0N_DEMO_MODE=false
